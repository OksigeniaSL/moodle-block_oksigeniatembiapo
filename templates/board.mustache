{{!
    @template block_oksigeniatembiapo/board

    «Your work»: one panel for every service the person runs. Above, «To sort out»: the alerts of all of them in one list,
    the urgent first, five in sight and the rest behind «and N more». Below, «Your services»: a door into each, all the same
    size, in a fixed order: one wide door, a row of up to four, rows of four, or compact when there are many. A plain look
    until the art direction's design.

    Example context (json):
    {
        "hasalerts": true, "hasmore": false, "morecount": 0, "morelabel": "", "more": [],
        "shown": [{"text": "«Comedor» has given no sign of life since 9:12", "url": "#", "level": "urgent", "urgent": true,
            "levellabel": "Urgent", "service": "Screens", "serviceicon": ""}],
        "hasdoors": true, "count": 1, "cols": 1, "layout": "one",
        "doors": [{"key": "local_oksigeniahechauka", "id": "tembiapo-screens", "title": "Screens", "url": "#",
            "status": "4 screens · 1 without a sign of life", "icon": "", "initial": "S", "alertcount": 1, "hasalerts": true,
            "urgent": true, "hasactions": true, "actions": [{"label": "Publish", "url": "#"}]}]
    }
}}
<div class="tembiapo is-{{layout}} cols-{{cols}}">
    {{#hasalerts}}
    <section class="tembiapo-zone tembiapo-alerts" aria-labelledby="tembiapo-alerts-{{uniqid}}">
        <h3 class="tembiapo-label" id="tembiapo-alerts-{{uniqid}}">{{#str}}alerts, block_oksigeniatembiapo{{/str}}</h3>
        <ul class="tembiapo-alert-list">
            {{#shown}}<li class="tembiapo-alert is-{{level}}">{{> block_oksigeniatembiapo/alert }}</li>{{/shown}}
        </ul>
        {{#hasmore}}
        <details class="tembiapo-more">
            <summary>{{morelabel}}</summary>
            <ul class="tembiapo-alert-list">
                {{#more}}<li class="tembiapo-alert is-{{level}}">{{> block_oksigeniatembiapo/alert }}</li>{{/more}}
            </ul>
        </details>
        {{/hasmore}}
    </section>
    {{/hasalerts}}
    <section class="tembiapo-zone tembiapo-services" aria-labelledby="tembiapo-services-{{uniqid}}">
        <h3 class="tembiapo-label" id="tembiapo-services-{{uniqid}}">{{#str}}doors, block_oksigeniatembiapo{{/str}}</h3>
        <ul class="tembiapo-doors">
            {{#doors}}
            <li class="tembiapo-door{{#urgent}} is-urgent{{/urgent}}">
                <a class="tembiapo-door-main" href="{{url}}">
                    <span class="tembiapo-door-icon" aria-hidden="true">{{#icon}}<img src="{{icon}}" alt="" width="40" height="40">{{/icon}}{{^icon}}{{initial}}{{/icon}}</span>
                    <span class="tembiapo-door-words"><span class="tembiapo-door-title">{{title}}</span>{{#status}}<span class="tembiapo-door-status">{{status}}</span>{{/status}}</span>
                    {{#hasalerts}}<span class="tembiapo-count" title="{{#cleanstr}}count, block_oksigeniatembiapo, {{alertcount}}{{/cleanstr}}"><span aria-hidden="true">{{alertcount}}</span><span class="visually-hidden sr-only">{{#str}}count, block_oksigeniatembiapo, {{alertcount}}{{/str}}</span></span>{{/hasalerts}}
                </a>
                {{#hasactions}}<span class="tembiapo-door-actions">{{#actions}}<a href="{{url}}">{{label}}</a>{{/actions}}</span>{{/hasactions}}
            </li>
            {{/doors}}
        </ul>
    </section>
</div>
