{{!
    @template block_oksigeniatembiapo/alert

    One line of «To sort out»: the service it is from, with its logo, how pressing it is, and what to do, straight to where
    it is done.

    Example context (json):
    {
        "text": "«Comedor» has given no sign of life since 9:12", "url": "#", "level": "urgent", "urgent": true,
        "levellabel": "Urgent", "service": "Screens", "serviceicon": ""
    }
}}
<li class="tembiapo-alert is-{{level}}"><a href="{{url}}"><span class="tembiapo-badge">{{levellabel}}</span><span class="tembiapo-alert-text">{{text}}</span><span class="tembiapo-alert-service">{{#serviceicon}}<img src="{{serviceicon}}" alt="" width="16" height="16">{{/serviceicon}}{{service}}</span></a></li>
